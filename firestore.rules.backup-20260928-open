// ─────────────────────────────────────────────────────────────────────────────
// 코스로드 Firestore 규칙 — 2026-09-28 이전의 **되돌리기용 백업** (프로젝트 cosroad-9a49c)
//
// ⚠ 이것은 전체 개방 규칙이다. 평상시 쓰는 규칙이 아니다.
//    코스로드 Firestore 의 모든 자료를 누구나 읽고·쓰고·지울 수 있다.
//    firestore.rules(새 규칙)를 적용한 뒤 앱이 깨졌을 때, 원인을 찾는 동안
//    **임시로만** 이 내용을 콘솔에 붙여넣어 되돌린다. 되돌린 상태로 오래 두지 말 것.
//
// 되돌리는 법: Firebase 콘솔 → Firestore Database → 규칙 → 아래 내용 전체 붙여넣기 → 게시
// ─────────────────────────────────────────────────────────────────────────────
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
