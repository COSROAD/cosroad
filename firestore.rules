// ─────────────────────────────────────────────────────────────────────────────
// 코스로드 Firestore 보안 규칙 (프로젝트 cosroad-9a49c) · 2026-09-28 (2차 — 두 모드 반영)
//
// 적용: Firebase 콘솔 → Firestore Database → 규칙 → 이 파일 내용 전체 붙여넣기 → 게시
// 되돌리기: firestore.rules.backup-20260928-open 내용을 붙여넣기 (전체 개방으로 복귀)
//
// 여기에 적히지 않은 경로는 **전부 거부**된다(Firestore 기본값).
//   → 새 컬렉션을 쓰는 기능을 만들면 이 파일에 경로를 반드시 추가해야 한다.
//     코드만 만들면 permission-denied 로 조용히 먹통이 된다.
//
// ── 이 앱의 구조 (코드 근거 — 규칙을 이해하는 데 꼭 필요) ────────────────────
// 기관(orgId)이 정해지는 길이 **두 갈래**이고, URL 이 로그인을 이긴다.
//   getFbOrgId() index.html:11567-11578
//     ① URL ?org=<orgId>            ← 최우선. 로그인 정보를 덮어쓴다
//     ② window._userOrgId           ← 로그인 계정의 users/{uid}.orgId (1864)
//     ③ FIXED_ORG_ID → localStorage → 'cosroad_default'
//
//   ㉠ 자체 가입 기관 : users/{uid}.orgId = 업종 + '_' + uid 앞 12자 (1840)
//                      ?org= 없이 접속 → ② 로 결정
//   ㉡ 마스터 개통 기관 : 마스터가 orgId = 업종 + '_' + 직접입력 으로 만들고(2194)
//                      https://cosroad.com/?org=<orgId> 주소를 업체에 넘긴다(2214)
//                      → ① 로 결정. **서버에 신원을 묶는 자료가 없다**
//   ㉢ 테스트 모드 : ?org=<이름>_test  ㉣ 데모 : ?org=<이름>_demo  ㉤ 마스터 : ?org=admin (6951)
//
// 2026-09-29(코스로드6) — ㉡ 개통 방식은 **폐기**됐다(사장님 결정). 모든 업체는 이메일·휴대폰
// 셀프 가입만 쓰고, 그 계정은 users/{uid}.orgId 에 자기 기관이 저장된다.
// 그래서 이제 `users/{uid}.orgId == orgId` 격리를 걸 수 있다 — 아래 isMyOrg() 가 그것이다.
// 예외 둘: 데모(_demo 읽기만) · 테스트(_test).
// 옛 기본 공간 cosroad_default 는 2026-09-29 에 **닫았다**(사장님 결정, 더 쓰지 않음).
//   자료를 지운 것이 아니라 접근만 막은 것이다 — 필요하면 이 규칙만 되돌리면 다시 열린다.
//
// 2026-09-29(코스로드8 ②) — 마스터도 **Firebase 계정**으로 들어온다.
// 전에는 코드에 적힌 비밀번호였고, 그래서 규칙이 "마스터임"을 확인할 수 없어
// 가입자 목록·문의함·마스터 자료를 로그인한 전체에게 열어 둘 수밖에 없었다.
// 이제 admins/{uid} 문서로 가린다(isAdmin()) — 그 세 곳을 닫았다.
//
// ── 이번 규칙이 실제로 막는 것 ──────────────────────────────────────────────
//  · 전체 개방(`/{document=**} if true`) 제거 — 규칙에 없는 경로 전부 거부
//  · 로그인(익명 포함) 없는 접근 전부 거부 — 토큰 없는 REST 접근 차단
//  · 공유 링크(shares) 완전 잠금 — 만료 검사 · 목록 차단 · 변조 차단 · 본인만 회수
//  · 남의 users 문서 읽기·수정·삭제, orgId 바꿔치기, 데모에 쓰기
// ─────────────────────────────────────────────────────────────────────────────
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── 도우미 ────────────────────────────────────────────────────────────
    // 앱은 로그인 사용자가 없으면 익명 로그인을 자동으로 한다(index.html:285-287).
    // 따라서 signedIn() 은 "사람을 가린다"는 뜻이 아니라
    // "정상 앱(Firebase SDK)을 통해서만 들어온다"는 뜻이다.
    function signedIn() {
      return request.auth != null;
    }
    function isDemoOrg(orgId) {
      return orgId.matches('.*_demo');
    }
    // 테스트 공간(?org=..._test) — 주소가 _test 로 끝나는가. 이름만 가린다.
    // 실서비스 가입은 _test 로 만들지 않는다.
    function isTestOrg(orgId) {
      return orgId.matches('.*_test');
    }
    // ── v253: _test 는 **마스터 전용**이다 (사장님 결정 10-29 · 설계문 v2 1장) ──
    // v252 까지는 자료 규칙이 isTestOrg(orgId) 만 보았다. 그래서 **로그인한 누구나**
    // _test 주소만 알면 사장님 테스트 자료를 읽고 쓸 수 있었다(기관 격리 우회).
    // 아래 자료·백업 규칙의 isTestOrg 자리를 **전부** 이 함수로 바꿨다.
    //   · _demo(둘러보기)는 그대로 둔다 — 가입 없이 보여 주는 것이 목적이다.
    //   · 마스터가 만든 _test 기사는 isActiveDriver 로 들어온다(ownerAlive 아래 참고).
    //
    // ── v253 보정2: 「🧪 테스트 출입」 표시 (사장님 결정 10-30) ──────────────
    // 사장님 휴대폰 계정(승인됨)으로도 _test 에 들어가고 싶다는 요청.
    // 마스터로 올리지 않는다 — 휴대폰 계정은 **문자 인증만으로 비번을 바꿀 수 있어서**
    // (v252 api/otp verify-reset) 마스터 권한을 얹으면 그 길이 마스터로 가는 문이 된다.
    // 그래서 _test **출입만** 여는 표시를 users 문서에 둔다. 켜고 끄는 것은 마스터만.
    //   ※ 이름은 testOrgAdmin 그대로 두었다(부르는 자리 5곳이 그대로라). 뜻은 이제
    //     「마스터이거나 테스트 출입이 허용된 계정」이다 — 아래 testAccessOk 참고.
    function testAccessOk() {
      return signedIn() && hasUserDoc()
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('testAccess', false) == true
             // 승인된 계정만 — 미승인·탈퇴 계정은 표시가 있어도 못 들어간다.
             // 기사 문서에는 approved 가 없으므로 **기사는 이 조건에서 막힌다**(2-c).
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('approved', false) == true
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('withdrawn', false) != true
             // v254: 기사 제외를 **조건으로 못 박았다.**
             //   v253 에서는 "기사 문서에는 approved 가 없으니 위 줄에서 막힌다"는
             //   **자료 모양 가정**에 기댔다. 그 가정이 깨진 문서(approved·testAccess 가
             //   함께 있는 기사 문서)를 에뮬레이터에 심어 보니 **통과했다.**
             //   지금 그런 문서를 만들 길은 없지만(createDriver 가 두 필드를 넣지 않고,
             //   users update 의 마스터 분기는 orgId 가 없는 기사 문서에서 평가 오류가 난다),
             //   가정 대신 조건으로 적는다. api/admin-account 의 isTestAccessFor 와 같은 뜻이 된다.
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') != 'driver';
    }
    function testOrgAdmin(orgId) {
      return isTestOrg(orgId) && (isAdmin() || testAccessOk());
    }
    function hasUserDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    // 전체 관리자(마스터)인가 — admins/{uid} 문서가 있으면 마스터다 (2026-09-29 코스로드8 ②).
    // 이 문서는 콘솔에서만 만든다(아래 admins 블록은 쓰기를 닫아 두었다).
    // 앱 쪽도 같은 문서를 본다(index.html checkIsAdmin) — 화면과 규칙이 같은 것을 근거로 삼는다.
    function isAdmin() {
      return signedIn()
             && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    // 이메일·휴대폰 가입 계정은 users/{uid}.orgId 에 자기 기관이 저장돼 있다(index.html 가입 흐름).
    // v250: .orgId 를 직접 읽으면 **기사 계정에서 터진다** — 기사 users 문서에는
    //   orgId 가 없고 driverOrg 가 있다. 터지면 || 뒤의 isActiveDriver 까지 못 가서
    //   기사가 자료를 못 읽는다. 그래서 .get(필드, 기본값) 으로 안전하게 읽는다.
    function isMyOrg(orgId) {
      return hasUserDoc()
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('orgId', '') == orgId;
    }

    // ── v263: 이용 기간 판정을 **한 줄**로 모았다 ──────────────────────────
    // v262 까지는 같은 뜻을 세 곳이 따로 셌다 —
    //   규칙(기사) ownerAlive · 앱 getTrialStatus · 앱 loadUserProfile.
    // 그래서 한 곳만 고치면 어긋났고, 소유자 쪽은 **아예 판정이 없었다**
    //   (isMyOrg 는 orgId 만 봤다 → 미입금·탈퇴·만료 업체도 앱 밖에서 읽고 쓸 수 있었다).
    // 이제 세 곳이 **이 한 줄과 같은 뜻**을 쓴다:
    //     살아 있음 = approved && !withdrawn && paidUntil > 지금
    // paidUntil 은 **밀리초 숫자**다(서버 api/admin-account 가 KST 23:59:59.999 로 넣는다).
    //   · 없으면 0 으로 읽어 「기간 없음」 = 막힘. 실사용 업체가 0곳이라 옛 계정 분기를 두지 않았다
    //     (사장님 결정 11-03). 사장님 계정·예제 업체는 마스터가 「기간 정하기」로 넣는다.
    //   · plan 글자('paid' 등)로는 **판정하지 않는다** — 오타 하나로 영구 무료가 된다.
    // ★ get 호출 수: 아래 셋은 전부 **users/{내 uid} 한 문서**만 본다(isMyOrg 가 이미 읽는 그 문서).
    //   그래서 새로 읽는 문서가 0개다 — 규칙 한 번에 10회(공식 문서) 한도에 여유가 생긴다.
    function userApprovedAlive(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.get('approved', false) == true
             && get(/databases/$(database)/documents/users/$(uid)).data.get('withdrawn', false) != true;
    }
    function userPaidNow(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.get('paidUntil', 0) > request.time.toMillis();
    }
    // 읽기용 — **만료돼도 자기 자료는 볼 수 있다**(사장님 결정: 만료 업체 = 읽기만).
    //   미입금(승인 대기)·탈퇴는 읽기도 막는다.
    function isMyOrgReadable(orgId) {
      return isMyOrg(orgId) && userApprovedAlive(request.auth.uid);
    }
    // 쓰기용 — 기간이 살아 있을 때만.
    function isMyOrgActive(orgId) {
      return isMyOrgReadable(orgId) && userPaidNow(request.auth.uid);
    }

    // ── orgs/{orgId}/data/{key} — 기관 자료 본체 ──────────────────────────
    // 회원·거래명세서·수납·세무·근태 등 앱 자료 전부. (12148 set · 12185 get · 12242 onSnapshot)
    // 두 모드(테스트 ?org=..._test · 개통 업체 ?org=...)가 모두 여기로 들어온다.
    // ── orgs/{orgId}/drivers/{uid} — 기사 계정 명부 (v250) ────────────────
    // **서버(api/admin-account.js)만 쓴다.** 클라이언트 쓰기를 열면 기사가 스스로를
    // 등록하거나 ownerUid 를 바꿔 남의 업체 자료를 열 수 있다.
    // v254: testOrgAdmin 을 더했다 — 보정2(v253)에서 「🧪 테스트 출입」을 만들 때
    //   자료·백업 다섯 자리만 바꾸고 **이 명부를 빼먹었다.** 그래서 출입 허용 계정으로
    //   _test 차량관리를 열면 기사 명부 읽기가 거부돼 「불러오는 중…」에서 멈췄다.
    //   (마스터는 isAdmin 으로 통과해서 증상이 안 보였다)
    match /orgs/{orgId}/drivers/{driverUid} {
      allow read:  if signedIn() && (isMyOrgReadable(orgId) || isAdmin() || testOrgAdmin(orgId) || request.auth.uid == driverUid);
      allow write: if false;                              // Admin SDK 전용
    }

    // ── 기사 권한 (v250) ──────────────────────────────────────────────────
    // 기사는 users/{uid}.role=='driver' 이고 orgs/{org}/drivers/{uid} 에 있는 계정이다.
    // **업체(소유자)가 살아 있을 때만** 열린다 — 사장님 결정: 업체 만료·탈퇴면 기사도 잠김.
    // ── v263: 소유자 활성 판정을 **위의 한 줄**로 바꿨다 ────────────────────
    //   전(v262): approved && !withdrawn && (plan=='paid' || trialStart 없음 || now < trialStart+30일)
    //     → get(users/소유자) 를 **5번** 썼고, 「plan 글자」와 「trialStart 없음」이
    //       사실상 **무기한 통과**를 만들었다.
    //   후(v263): approved && !withdrawn && paidUntil > 지금  (get 3번)
    //   앱(getTrialStatus)·소유자 규칙(isMyOrgActive)과 **글자까지 같은 뜻**이다.
    //   paidUntil 은 밀리초 숫자라 request.time.toMillis() 와 바로 견준다.
    function driverDoc(orgId) {
      return get(/databases/$(database)/documents/orgs/$(orgId)/drivers/$(request.auth.uid)).data;
    }
    // v253: 마스터가 소유자인 경우를 먼저 본다.
    //   마스터가 _test 기관의 기사 계정을 만들면 ownerUid = 마스터 uid 가 된다
    //   (api/admin-account resolveOwnerUid 의 _test 분기, v251). 마스터는 users 문서가
    //   없으므로 아래 users 검사에서 전부 막힌다 — _test 를 마스터 전용으로 좁힌 뒤에는
    //   그 기사가 자료를 **전혀** 못 보게 된다. 그래서 「소유자가 마스터면 살아 있음」을 더한다.
    //   ※ 실업체 기사는 resolveOwnerUid 가 **실제 소유자**를 넣으므로 이 분기에 걸리지 않는다.
    //   ※ drivers 문서는 allow write:false(Admin SDK 전용)라 ownerUid 를 사람이 못 적는다.
    function ownerAlive(ownerUid) {
      return exists(/databases/$(database)/documents/admins/$(ownerUid))
             || (
                  exists(/databases/$(database)/documents/users/$(ownerUid))
                  && userApprovedAlive(ownerUid)
                  && userPaidNow(ownerUid)
                );
    }
    function isActiveDriver(orgId) {
      return signedIn()
             && exists(/databases/$(database)/documents/orgs/$(orgId)/drivers/$(request.auth.uid))
             && ownerAlive(driverDoc(orgId).ownerUid);
    }
    // 기사 화면이 **실제로 저장하는** 키만 쓰게 한다 (코드에서 전수 추출 — v250 보고서 표).
    //   driverAtt       출퇴근 (PIN·단추)
    //   carlog          차계부·계기판
    //   attendance      PIN 출석 체크
    //   attendanceTime  출석 시각
    //   deliveryDone    납품·배송 완료 표시
    //   dropoffDone     하차 완료 표시
    //   rideState       탑승·하차·완료 토글 (v250에서 members 에서 떼어낸 키)
    // ★ members 는 **넣지 않는다** (사장님 결정 10-25).
    //   기사 화면이 저장하던 것은 토글(on·offOn)뿐이었는데 그것이 members 안에 있어서
    //   이름·연락처·주소·PIN·«수강료»까지 쓰기 권한이 열렸다. 토글을 rideState 로 떼어
    //   members 는 기사가 **읽기만** 한다(운행에 이름·주소·연락처가 필요하다).
    // ── v255: driverAtt 를 **뺐다** ──────────────────────────────────────
    //   출퇴근은 이제 api/driver-auth(checkin·checkout·pinCheckin)가 **서버 시각**으로
    //   트랜잭션으로 쓴다. 기사 폰이 직접 쓰면 ① 폰 시각을 바꿔 출근 시각을 속일 수 있고
    //   ② 기사 둘이 같은 순간에 찍으면 키 하나를 통째로 덮어 **앞 기록이 사라진다.**
    //   ★ 관리자(소유자·마스터·_test 출입)의 driverAtt 쓰기는 **그대로 열려 있다** —
    //     직원 출퇴근(같은 키, attKey(staffId,날짜))과 관리자 수동 토글이 거기로 들어온다.
    // ── v257: 기사 쓰기에서 **출결을 뺐다** ──────────────────────────────
    //   v256 보정2 에서 기사 화면의 PIN 판을 없애(출석은 관리자 화면만) v257 에서
    //   둘러보기까지 같게 맞췄다. 그래서 기사 화면에는 출결을 저장하는 길이 **0개**다.
    //   전수 확인(코드 호출 그래프 + 실제로 돌려 보기, 보고문 참조):
    //     · 운행 화면 카드 토글(toggleStudent)은 rideState 에만 쓴다 — attendance 는 안 건드린다
    //     · 출석/결석 단추(setAttendance)·날짜 점검(dcMoveAttendance)·백업 복원(restoreData)은
    //       모두 관리 화면 기능이고, 기사는 switchTab 가드로 관리 화면에 못 들어간다
    //     · PIN 판(checkPin)은 openPinCheckin 가드로 기사 모드에서 안 열린다
    //   앱 쪽 같은 목록: index.html 의 DRIVER_WRITE_KEYS — **두 곳을 같이 고쳐야 한다.**
    //   ※ 관리자·소유자의 attendance 쓰기는 그대로다(직원 근태·수기 토글이 같은 키를 쓴다).
    // ── v275(40-C): **비웠다.** 기사가 `data/*` 에 쓰는 것은 이제 **하나도 없다** —
    //   쓰는 것은 위 `carState/{내 차량}` 문서뿐이다. 앱 `DRIVER_WRITE_KEYS` 도 빈 배열이다.
    //   ★ 이걸 비우면 아래 `backups` create 의 기사 분기가 **닫힌다** →
    //     그래서 거기에 「기사는 **자기 carState** 백업만」 을 따로 열어 두었다.
    function driverWritableKey(key) {
      return false;
    }

    // ── v255: 기사는 **운행에 필요한 키만** 읽는다 ───────────────────────
    //   v254 까지는 read 가 키를 가리지 않아서, 기사 한 명이 업체의 **수납·세무·
    //   급여수기·직원명부**를 전부 읽을 수 있었다(앱 리스너가 17키를 통째로 받았다).
    //   아래 12키는 기사 화면(운행·회원 두 탭)이 실제로 쓰는 것만 골랐다.
    //   막은 것: payments · tax · payrollManual · staff · drivelogManual ·
    //            invoices · products · certificates · **driverPay**(급여 값, v255 신설)
    //   ※ products·invoices 는 기사 화면에서 쓰지 않음을 확인했다 —
    //     loadProducts·loadInvoices 호출자가 전부 관리 탭 기능이다(거래명세서·품목·수납·점검).
    // ── v258: 읽기에서도 **출결을 뺐다** (12키 → 10키) ────────────────────
    //   v257 에서 쓰기를 뺀 뒤 읽기를 다시 보니, 기사 화면에는 «회원» 출결을
    //   **읽는 자리가 없었다.** 그런데도 앱의 덩어리 동기화(syncFromFirebase)와
    //   리스너(startFirebaseListeners)가 키 목록을 그대로 훑어서, 업체의 출결 기록
    //   전체가 기사 폰에 내려오고 있었다(리스너가 두 자리에 붙는 것을 실측).
    //   전수 확인(코드 호출 그래프 + 실제 실행, 보고문 참조): 기사 화면 입구 16개에서
    //     loadAttendance · loadAttendanceTime · getAttendanceToday · attTimeInfo
    //   에 닿는 길 0개. 대조로 관리자 입구(출결관리·날짜 점검·PIN 체크인)는 닿는다.
    //   앱 쪽 같은 목록: index.html 의 DRIVER_READ_KEYS — **두 곳을 같이 고쳐야 한다.**
    //   ※ 관리자·소유자 읽기·쓰기는 그대로다. 기사 출퇴근(driverAtt)은 남겨 둔다 —
    //     기사 화면이 자기 출근·퇴근 시각을 보여 준다(driverPunchBarHtml).
    // ── v272: 기사 폰에 가는 것을 두 가지 줄였다 (앱 DRIVER_READ_KEYS 와 **같이** 고친다)
    //   · `notices` 를 **뺐다** — 기사 화면에 알림장을 그리는 자리가 **0곳**이다
    //     (renderNotice 를 부르는 여덟 곳이 전부 admin-content · 실제 실행으로도 확인).
    //     그런데도 덩어리 동기화·리스너가 키 목록을 훑어 **알림장 본문과 대상 회원 이름**이
    //     기사 폰에 내려오고 있었다. v258 의 「출결 빼기」와 같은 자리·같은 방법.
    //   · `org` → **`orgDriver`** — `org` 에는 입금 계좌(bankAccount)·도장 그림(stamp)·
    //     사업자등록번호·대표자·4대보험 요율·발신번호가 들어 있다. 기사가 **실제로 읽는 칸**은
    //     일곱뿐이라(name·icon·bizType·destName·destLat·destLon·tel · 실제 실행으로 셈)
    //     그 칸만 담은 요약 문서를 따로 두고 기사는 그것만 읽는다.
    //     ★ `orgDriver` **쓰기는 관리자·소유자만** — 아래 driverWritableKey 에 넣지 않았다.
    //       요약은 관리자가 업체 설정을 저장할 때(saveOrgSettings) 같이 쓰이고,
    //       옛 업체는 관리자가 들어올 때 한 번 만들어진다(syncFromFirebase).
    // ── v274(40-B): `members`·`cars`·`courses` 를 **뺐다** (앱 DRIVER_READ_KEYS 와 **같이**)
    //   기사 폰이 업체 **전체 명단**(이름·주소·연락처)을 받고 있었다. `members` 는 기관 키
    //   하나라 여기서는 차량별로 못 나눈다 — 그래서 **차량별 사본**을 따로 두고
    //   아래 `carData/{carId}` 블록이 **자기 차량 문서만** 열어 준다.
    //   남은 네 키(rideState·carlog·deliveryDone·dropoffDone)와 driverAtt 는 40-C 에서 옮긴다.
    // ── v275(40-C): 다섯 키를 **더 뺐다** → 기사가 `data/*` 에서 읽는 것은 **`orgDriver` 하나**다.
    //   탑승 토글·차계부·납품/하차 완료·기사 출퇴근은 위 `carState/{carId}` 로 옮겼다.
    //   앱 `DRIVER_READ_KEYS` 와 **같은 목록**이어야 한다.
    function driverReadableKey(key) {
      return key in ['orgDriver'];
    }

    // ── 차량별 읽기용 사본 (v274 · 40-B) ──────────────────────────────────
    //   관리자가 차량마다 만들어 두는 **사본**이다 — «회원»(그 차량 몫) · 자기 차량 한 칸 · 코스.
    //   기사는 **자기 차량 문서만** 읽는다. 쓰기는 **관리자·소유자만**(기사는 읽기 전용).
    //   ★ 가리는 기준은 `request.auth.token.carId`(폰이 보내는 값)가 아니라
    //     **`drivers/{uid}.carId`(서버에 있는 문서)** 다 — 규칙이 이미 isActiveDriver 안에서
    //     그 문서를 읽으므로 맞출 것이 하나 줄고, claim 모양이 바뀌어도 규칙은 그대로다.
    //     (기사 uid 가 `drv_<org>_<carId>` 라 둘이 어긋날 수는 없다 — 코스로드40 설계 보고 2-5)
    //   ★ 사본에는 수강료·출석 PIN·거래처 사업자 칸·발신번호를 **담지 않는다**(앱이 고른다).
    function myCarId(orgId) {
      return driverDoc(orgId).carId;
    }

    match /orgs/{orgId}/carData/{carId} {
      allow read:  if signedIn()
                   && (isMyOrgReadable(orgId) || isDemoOrg(orgId) || testOrgAdmin(orgId)
                       || (isActiveDriver(orgId) && myCarId(orgId) == carId));
      allow write: if signedIn()
                   && !isDemoOrg(orgId)                                   // 데모는 읽기 전용
                   && (isMyOrgActive(orgId) || testOrgAdmin(orgId));      // 기사 쓰기 없음
    }

    // ── 차량별 운행 기록 (v275 · 40-C) ────────────────────────────────────
    //   그 차량 몫의 **유일한 원본**이다 — 탑승 토글·차계부·납품/하차 완료·기사 출퇴근.
    //   읽기·쓰기 모두 **그 차량 기사와 관리자**만. 기사끼리는 서로 못 덮는다
    //   (문서가 갈려 있어 **동시에 저장해도 남의 기록이 안 지워진다** — 40-B 에서 겪은 문제).
    //   직원 근태(`st…`)는 차량과 무관하므로 `data/staffAtt`(관리자 전용)에 따로 둔다.
    match /orgs/{orgId}/carState/{carId} {
      allow read:  if signedIn()
                   && (isMyOrgReadable(orgId) || isDemoOrg(orgId) || testOrgAdmin(orgId)
                       || (isActiveDriver(orgId) && myCarId(orgId) == carId));
      allow write: if signedIn()
                   && !isDemoOrg(orgId)                                   // 데모는 읽기 전용
                   && (isMyOrgActive(orgId) || testOrgAdmin(orgId)
                       || (isActiveDriver(orgId) && myCarId(orgId) == carId));
    }

    match /orgs/{orgId}/data/{key} {
      // 기관 격리(코스로드6): 남의 주소(?org=)를 알아도 자기 users.orgId 와 다르면 거부된다.
      allow read:  if signedIn()
                   && (isMyOrgReadable(orgId) || isDemoOrg(orgId) || testOrgAdmin(orgId)
                       || (isActiveDriver(orgId) && driverReadableKey(key)));
      allow write: if signedIn()
                   && !isDemoOrg(orgId)                                   // 데모는 읽기 전용
                   && (isMyOrgActive(orgId) || testOrgAdmin(orgId)
                       || (isActiveDriver(orgId) && driverWritableKey(key)));
    }

    // ── orgs/{orgId}/backups/{backupId} — 자동 백업 ───────────────────────
    // (12120 create · 12124 list · 12134 delete)
    match /orgs/{orgId}/backups/{backupId} {
      // 자료 본체와 같은 격리를 건다. 백업만 열려 있으면 격리가 뚫린다.
      // ── v255: 기사 **읽기를 막았다** ────────────────────────────────────
      //   백업에는 막아야 할 키(수납·세무·급여)의 **지난 값**이 들어 있다.
      //   본체 read 를 12키로 좁혀도 백업이 열려 있으면 그 길로 다 읽힌다.
      //   ※ 기사 저장은 깨지지 않는다 — _backupBeforeSave 는 백업을 만든 뒤
      //     오래된 것을 지우려고 목록을 읽는데, 그 읽기가 막히면 catch 가 삼키고
      //     「백업 실패(저장은 계속)」만 찍는다(index.html:14966). 본 저장은 그대로다.
      //   delete 도 기사에게서 뺐다 — 목록을 못 읽으니 어차피 못 쓰는 길이고,
      //     문서 id 를 찍어 지우는 길까지 닫는다. 오래된 백업 정리는 관리자 쪽에서 된다.
      allow read:   if signedIn()
                    && (isMyOrgReadable(orgId) || isDemoOrg(orgId) || testOrgAdmin(orgId));
      // 백업 문서에는 어느 키의 백업인지 `key` 필드가 있다(_backupBeforeSave) —
      // 문서 id(`<key>__<시각>`)를 쪼개는 대신 그 필드를 본다.
      // create 는 **남긴다** — 기사가 쓰는 키(carlog·rideState 등)를 저장할 때
      // 덮어쓰기 직전 백업이 여기로 들어온다. 막으면 기사 저장 때마다 백업이 빠진다.
      // ── v275: `driverWritableKey` 를 비웠으므로 기사 분기를 **자기 carState 백업**으로 바꿨다.
      //   앱은 자기 차량 기록을 덮어쓰기 직전 `key: 'carState/<내 차량>'` 으로 백업을 남긴다
      //   (_backupBeforeSave). 이걸 안 열어 두면 기사 저장 때마다 백업이 빠진다.
      allow create: if signedIn() && !isDemoOrg(orgId)
                    && (isMyOrgActive(orgId) || testOrgAdmin(orgId)
                        || (isActiveDriver(orgId)
                            && request.resource.data.key == 'carState/' + myCarId(orgId)));
      allow delete: if signedIn() && !isDemoOrg(orgId)
                    && (isMyOrgActive(orgId) || testOrgAdmin(orgId));
      allow update: if false;                            // 백업은 덮어쓰지 않는다
    }

    // ── orgs/cosroad_global/data/{key} — 전 계정 공통 설정 ────────────────
    // v253: **마스터만**으로 닫았다 (사장님 결정 10-30).
    // 전에는 `read, write: if signedIn()` 이어서 **로그인한 누구나 읽고 썼다.**
    // 알리고 문자 설정(key==='aligo')을 전 업종이 함께 쓰던 자리인데, 그때는 규칙이
    // 마스터를 식별할 수 없어 열어 두고 "다음 단계에서 좁힌다"고 적어 두었다.
    // v249 에 마스터가 실계정(admins/{uid})이 되었으므로 이제 좁힌다.
    // 닫아도 안전한 근거 (2026-10-30 확인):
    //   · 앱이 이 자리를 쓰는 호출이 **0건**이다. saveToFirebase·loadFromFirebase 가
    //     key==='aligo' 일 때만 여기로 가는데, 'aligo' 를 넘기는 호출자가 없다
    //     (saveAligoSettings 는 "서버에서 관리합니다" 안내만 하고, 키는 Vercel 환경변수에만).
    //   · 사장님 콘솔 확인: orgs 아래 cosroad_global 문서 자체가 없다.
    match /orgs/cosroad_global/data/{key} {
      allow read, write: if isAdmin();
    }

    // ── users/{uid} — 계정 ────────────────────────────────────────────────
    // 본인 문서: 가입 생성 · 로그인 시 읽기 · 탈퇴 표시. 목록·승인은 마스터 패널.
    // 2026-09-29(코스로드8 ②) 마스터가 실계정이 되어 **가입자 목록을 닫았다** —
    //   전에는 로그인한 누구나 남의 이메일·요금제·orgId 를 훑어볼 수 있었다.
    match /users/{uid} {
      allow get:    if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list:   if isAdmin();                        // 마스터 가입자 목록 (닫음)
      // ── v261: 가입 문서 만들기를 **서버 전용으로 닫았다** ──────────────────
      //   v249~v260 은 「앱이 만드는 그 모양」만 허용했다(approved:false·plan:'pending' 등).
      //   그래도 **브라우저가 직접** 계정을 만들고 이 문서를 쓸 수 있었으므로,
      //   휴대폰 인증과 사업자 확인을 **건너뛴 가입**이 가능했다.
      //   또 모양 검사는 role·driverOrg·ownerUid·carId·testAccess 같은 키를 막지 않았다.
      //   이제 가입은 **api/signup.js(Admin SDK)** 만 만든다 —
      //   인증번호 확인 → 국세청 사업자 진위·계속사업자 확인 → 계정 → 이 문서 순서로,
      //   문서 쓰기가 실패하면 방금 만든 계정을 지운다(반쪽 계정 금지).
      //   Admin SDK 는 규칙을 거치지 않으므로 false 로 닫아도 가입은 된다.
      allow create: if false;                            // 서버(api/signup.js)만
      // 본인은 자기 문서를 고칠 수 있다. 단 두 가지를 막는다 —
      //   ① orgId : 바꿀 수 있으면 남의 기관으로 옮겨탄다.
      //   ② approved · status · plan · trialStart :
      //      **마스터가 입금을 확인하고 정하는 값**이다. 본인이 바꿀 수 있으면
      //      승인을 스스로 찍고 무료 기간도 스스로 늘린다 — 돈이 걸린 자리다.
      //      본인이 고칠 수 있는 것은 기관명·연락처·탈퇴표시 같은 자기 정보뿐이다.
      allow update: if signedIn()
                    && (
                         // v250: bizType 도 본인이 못 바꾸게 했다(연관 ②) —
                         //   바꿀 수 있으면 orgId 접두(academy_…)와 어긋난 문서가 생기고
                         //   화면 용어·탭 구성이 통째로 달라진다.
                         // v250: 기사 문서(role:'driver')는 role·driverOrg·ownerUid·carId 도 잠근다 —
                         //   기사가 driverOrg 를 바꾸면 **남의 업체 자료**를 열 수 있다.
                         (request.auth.uid == uid
                          && request.resource.data.orgId == resource.data.orgId
                          && !request.resource.data.diff(resource.data).affectedKeys()
                         // v253 보정2: testAccess 도 본인이 못 켜게 막는다 —
                         //   켤 수 있으면 아무 계정이나 스스로 _test 출입을 허가한다.
                         // v261: 사업자 확인 결과와 로그인 번호도 본인이 못 바꾸게 막는다 —
                         //   바꿀 수 있으면 「확인된 사업자」가 아닌 값으로 갈아 끼울 수 있고,
                         //   phone 을 고치면 로그인 아이디(번호@phone.cosroad.com)와 어긋난다.
                         //   사업자 정보는 api/signup.js 가 국세청 응답으로만 적고,
                         //   번호 바꾸기는 마스터가 api/otp.js changePhone 으로 한다(둘 다 Admin).
                         // v263: 이용 기간 값 네 개도 본인이 못 바꾸게 막는다 —
                         //   paidUntil 은 **규칙이 보는 단 하나의 값**이다. 본인이 쓸 수 있으면
                         //   10년 뒤로 적어 영원히 쓸 수 있다. 서버(api/admin-account)만 쓴다.
                                .hasAny(['approved','status','plan','trialStart','bizType',
                                         'role','driverOrg','ownerUid','carId','testAccess',
                                         'bizNo','bizCeo','bizOpenDate','bizCheckedAt','bizNoDup',
                                         'signupMethod','phone',
                                         'paidUntil','trialEnd','contractMonths','paidAt']))
                         // ★ 마스터 승인 — 승인 한 번에 네 값이 함께 바뀐다
                         //   (approved:true · status:'active' · trialStart=승인시각 · plan:'trial').
                         //   approved 하나만 허용하면 승인 자체가 막힌다(고쳐서 넓힘).
                         //   orgId·email 은 그대로여야 한다 = 남의 기관으로 옮기거나
                         //   아이디를 바꿔치기하는 쓰기는 여전히 거부된다.
                         //   email 은 휴대폰 가입 계정에 없을 수 있어 get(,'') 로 읽는다.
                         // v253 보정2: testAccess 를 **마스터만** 켜고 끌 수 있게 더했다.
                         //   끄기는 필드를 지우는 것인데, affectedKeys() 는 더한 키·바뀐 키·
                         //   **지운 키**를 모두 세므로 이 목록 하나로 켜기·끄기가 다 덮인다.
                         //   ※ 이 분기는 orgId 가 있는 문서에서만 통한다(기사 문서에는 orgId 가
                         //     없어 비교 자체가 터진다) → 마스터도 기사 문서엔 testAccess 를 못 쓴다.
                         // ── v263: 마스터가 **화면에서** 쓸 수 있는 것은 testAccess 하나뿐 ──
                         //   승인·승인취소·기간(돈이 걸린 값)은 **서버(api/admin-account)** 가 쓴다.
                         //   Admin SDK 는 규칙을 거치지 않으므로 여기서 닫아도 승인은 된다.
                         //   닫는 이유: 마스터 브라우저가 털리면 그 자리에서 paidUntil 을
                         //   10년 뒤로 적을 수 있었다. 이제 그 길이 없다.
                         || (isAdmin()
                             && request.resource.data.orgId == resource.data.orgId
                             && request.resource.data.get('email','') == resource.data.get('email','')
                             && request.resource.data.diff(resource.data).affectedKeys()
                                .hasOnly(['testAccess']))
                       );
      // 탈퇴해도 본인은 지우지 못한다(사장님 결정) — withdrawn 표시만 남기고 로그인을 막는다.
      // 다만 **승인 대기(미승인) 신청은 마스터가 정리할 수 있다**(대기 목록 청소용, v232).
      // 승인된 계정은 기관 자료가 딸려 있으므로 여전히 못 지운다 — 자료 보존 원칙 유지.
      // 지우려면 먼저 승인을 취소해야 한다(그때 approved 가 false 가 된다).
      // approved 필드가 아예 없는 옛 문서도 지울 수 있어야 한다 —
      // resource.data.approved 로 바로 읽으면 없는 필드에서 평가 오류가 나 거부된다.
      // (email 을 get(,'') 로 읽는 위 규칙과 같은 이유·같은 방식)
      //
      // ★ v253: 기사 문서는 **api/admin-account(removeDriver)로만** 정리한다 —
      //   마스터 패널에서 지우면 기사 로그인이 깨진다.
      //   기사 문서에는 approved 가 없어(createDriver 가 넣지 않는다) 위 조건만으로는
      //   「미승인 신청」으로 보여 지울 수 있었다. 앱에서도 목록에서 걸러내지만(drawMasterPanel
      //   orgUsers), 규칙에서도 막아 두 겹으로 지킨다.
      allow delete: if isAdmin()
                    && resource.data.get('approved', false) != true
                    && resource.data.get('role', '') != 'driver';
    }

    // ── admins/{uid} — 전체 관리자 명단 ───────────────────────────────────
    // 콘솔에서만 만든다. 앱은 "내가 마스터인가"만 확인한다(자기 문서 읽기).
    // 쓰기를 열면 스스로 마스터가 될 수 있으므로 **앱에서는 절대 못 쓴다.**
    match /admins/{uid} {
      allow get:    if signedIn() && request.auth.uid == uid;
      allow list:   if false;
      allow write:  if false;
    }

    // ── otp/{id} — 문자 인증번호 (v252) ───────────────────────────────────
    // 앱은 이 컬렉션을 **보지도 쓰지도 않는다.** 인증번호를 만들고 맞추는 일은
    // 전부 api/otp.js(Admin SDK)가 한다 — Admin SDK 는 이 규칙을 거치지 않는다.
    // 열어 두면 코드 해시·발송 기록·빈도 제한 기록을 남이 읽거나 지울 수 있다
    // (지울 수 있으면 빈도 제한이 무의미해져 문자 폭탄 구멍이 된다).
    match /otp/{id} {
      allow read, write: if false;
    }

    // ── billingLog/{uid}/items/{id} — 승인·연장 기록 (v263) ────────────────
    // 마스터가 「언제 얼마를 받아 몇 달을 열어 줬나」를 보는 자리다.
    // **쓰기는 서버(api/admin-account, Admin SDK)만** — 금액이 적힌 자리를 브라우저가
    //   쓸 수 있으면 기록 자체를 믿을 수 없게 된다.
    // 업체 본인에게는 **읽기도 열지 않는다** — 받은 금액·메모는 업체가 볼 이유가 없고,
    //   users 문서(본인이 읽을 수 있다)에는 요약 값(paidUntil·trialEnd·contractMonths)만 둔다.
    match /billingLog/{uid}/items/{itemId} {
      allow read:  if isAdmin();
      allow write: if false;                             // Admin SDK 전용
    }

    // ── bizFirstPay/{sha256(사업자번호)} — 첫 결제 할인 1회 (v264) ──────────
    // 첫 결제 할인은 **사업자등록번호당 한 번**이다(계정당이 아니다 — 같은 사업자가
    // 새 번호로 다시 가입해도 또 받으면 안 된다). 그 「받았음」 표시를 두는 자리다.
    // **쓰기는 서버(api/admin-account, Admin SDK)만** — 브라우저가 지울 수 있으면
    //   지우고 다시 받는 길이 열려 할인이 무제한이 된다.
    // 문서 id 는 사업자번호의 **해시**다 — 열려도 번호 목록이 되지 않게 한다.
    // 마스터만 읽는다(승인 창에서 「이미 받음」을 보여 주려고). 업체에는 열지 않는다.
    match /bizFirstPay/{id} {
      allow read:  if isAdmin();
      allow write: if false;                             // Admin SDK 전용
    }

    // ── sendRl/{id} — 문자·알림톡 빈도 기록 (v266) ─────────────────────────
    // 업체별(1분·하루) · 문의 IP별(1분·하루) 발송 수를 세는 자리다.
    // **아무도 읽지도 쓰지도 못한다** — api/send-sms·api/send-alimtalk(Admin SDK)만 다룬다.
    // ★ 지울 수 있으면 상한이 무의미해져 문자 폭탄이 공짜가 된다(otp 의 rl.* 와 같은 이유).
    // ★ id 는 업체 이름·IP 의 **해시**다 — 열려도 업체 목록·IP 목록이 되지 않게.
    match /sendRl/{id} {
      allow read, write: if false;                       // Admin SDK 전용
    }

    // ── 기사 로그인 (v255) — 다섯 컬렉션 **전부 서버 전용** ────────────────
    // 앱은 이 컬렉션들을 보지도 쓰지도 않는다. api/driver-auth.js 와
    // api/admin-account.js(Admin SDK)만 다룬다 — Admin SDK 는 이 규칙을 거치지 않는다.
    // 관리자가 보는 것(PIN 설정 여부·기기 묶임·최근 로그인)은 api driverInfo 가 골라 준다.
    //
    // orgCodes/{6자리}      { orgId }            — 업체 번호 → 기관 대응표
    //   ★ 열면 번호를 훑어 **남의 업체를 찾아** PIN 대입을 시작할 수 있다.
    // driverPins/{org}_{car} { pinHash, carId }  — PIN 해시
    //   ★ 4자리라 해시가 새면 **오프라인에서 1만 번**이면 뚫린다.
    // driverDevices/{org}_{car} { deviceId }     — 첫 로그인 기기 묶기
    //   ★ 열면 기기 id 를 베껴 기기 묶기가 무의미해진다.
    // driverLogins/{자동id}  { at, ok, lat, lng } — 로그인 기록(**위치 포함**)
    //   ★ 사람의 위치 기록이다. 가장 세게 닫는다.
    // driverRl/{해시}        { at:[…] }          — 틀린 횟수·IP 제한 (otp rl.* 와 같은 꼴)
    //   ★ 지울 수 있으면 잠금이 무의미해져 PIN 대입이 공짜가 된다.
    match /orgCodes/{code}      { allow read, write: if false; }
    match /driverPins/{id}      { allow read, write: if false; }
    match /driverDevices/{id}   { allow read, write: if false; }
    match /driverLogins/{id}    { allow read, write: if false; }
    match /driverRl/{id}        { allow read, write: if false; }

    // ── inquiries/{id} — 문의 ─────────────────────────────────────────────
    // 보내기는 누구나(익명 로그인 포함) 되어야 한다 — 로그인 전 화면에서도 문의한다.
    // 읽기·처리는 마스터 패널만 쓴다. 2026-09-29(코스로드8 ②) 마스터가 실계정이 되어 **닫았다** —
    // 전에는 로그인한 누구나 남이 보낸 문의(연락처 포함)를 읽을 수 있었다.
    match /inquiries/{id} {
      allow create: if signedIn();
      allow read:   if isAdmin();
      allow update: if isAdmin();
      // v253: 처리가 끝난 문의는 마스터가 지울 수 있다 (설계문 10장 · 마스터 패널 🗑).
      // **완료(status=='done')만** 열어 둔다 — 신규·처리중을 지우면 접수 기록이 사라진다.
      // status 필드가 없는 옛 문서도 있으므로 .get(기본값) 으로 읽는다
      // (직접 읽으면 필드가 없을 때 규칙이 터져 거부된다 — 어차피 거부지만 뜻을 또렷하게 둔다).
      allow delete: if isAdmin() && resource.data.get('status', '') == 'done';
    }

    // ── orgs/_master/data/{key} — 마스터 자료 (개통 대장 · 입금 계좌 안내) ──
    // 이 블록이 위의 orgs/{orgId}/data/{key} 보다 뒤에 있어도 무방하다 —
    // Firestore 는 allow 를 합집합으로 본다(어느 하나라도 허용이면 허용).
    //
    // billing(입금 계좌 안내)만은 **승인 대기 중인 가입자도 읽어야 한다** —
    // 승인 대기 화면이 이 값을 읽어 계좌를 보여준다(index.html loadBillingInfo).
    // 마스터만으로 좁히면 계좌 칸이 영영 «준비 중»으로 남는다. 쓰기는 마스터만 한다.
    match /orgs/_master/data/{key} {
      allow read:  if isAdmin() || (signedIn() && key == 'billing');
      allow write: if isAdmin();
    }

    // ── shares/{token} — 카톡 공유 링크 스냅샷 (REPLY_32 확정본) ──────────
    // 여기는 신원이 필요 없어 **완전히 잠글 수 있다.**
    // 방어선 ① 추측 불가 토큰(128비트) ② list 차단 ③ 만료. "로그인됨"은 방어가 아니다.
    // ── 공유 스냅샷 내용 검사 (v248) ─────────────────────────────────────
    // 전에는 "로그인했고 · 만료가 미래고 · ownerUid 가 자기 uid" 뿐이어서,
    // 익명 로그인만 해도 **아무 내용이나** shares 에 넣을 수 있었다.
    // s.html 은 앱과 같은 cosroad.com 이라, 남이 만든 문서가 열리면 앱까지 위험해진다.
    // 그래서 ① 종류 ② 키 구성 ③ 만료 상한 ④ 알림장 크기 를 서버에서 가린다.
    // 키 목록은 index.html 의 발급 함수가 **실제로 저장하는 키**를 뽑아 적었다
    //   oneInvoice·clientRange 12개 / notice 9개 / payslip 17개
    // hasOnly 는 부분집합을 허용하므로, ownerUid 가 없는 문서는 아래 ownerUid 검사에서 걸린다.
    function shKind() { return request.resource.data.kind; }
    function shKeys() { return request.resource.data.keys(); }
    function shShapeOk() {
      return (
        (shKind() in ['oneInvoice', 'clientRange'])
        && shKeys().hasOnly(['v','kind','org','client','period','count','rows','totals','net','createdAt','expiresAt','ownerUid'])
      ) || (
        shKind() == 'notice'
        && shKeys().hasOnly(['v','kind','org','date','content','images','createdAt','expiresAt','ownerUid'])
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 5000
        && request.resource.data.images is list
        && request.resource.data.images.size() <= 2
      ) || (
        shKind() == 'payslip'
        && shKeys().hasOnly(['v','kind','org','ym','payDate','worker','workDays','totalHours','lines','total','deductions','dedTotal','meal','net','createdAt','expiresAt','ownerUid'])
      );
    }
    match /shares/{token} {
      allow get:    if resource.data.expiresAt > request.time;   // 만료되면 못 읽는다
      allow list:   if false;                                    // 토큰 없이 훑기 차단
      allow update: if false;                                    // 스냅샷 변조 차단
      allow create: if signedIn()
                    && request.resource.data.expiresAt > request.time
                    // 만료는 최대 31일 — 앱은 30일(명세서·알림장)·7일(급여)만 쓴다
                    && request.resource.data.expiresAt <= request.time + duration.value(31, 'd')
                    && request.resource.data.ownerUid == request.auth.uid
                    && shShapeOk()
                    // ── 만드는 사람 (v249) ──────────────────────────────
                    // v248 에서는 넣지 못했다 — 그때는 앱에 **기기 비밀번호 진입**이 있어서
                    // 로컬 비밀번호로 들어온 사용자가 익명 계정이었고, 이 조건을 걸면
                    // 그분들의 공유가 전부 막혔다.
                    // v249 에서 기기 비밀번호 진입을 없애 모두 계정으로 로그인하므로 이제 넣는다.
                    //   · 승인된 업체 계정 → 통과
                    //   · 마스터(admins/{uid}) → 통과 (사장님은 _test 에서도 이쪽으로 통과한다)
                    //   · 익명·미승인 → 거부
                    // v263: approved 만 보던 것을 **활성 한 줄**로 바꿨다 —
                    //   전에는 만료·탈퇴한 업체도 공유 링크(거래명세서·급여명세서·알림장)를
                    //   계속 발급할 수 있었다. 읽기(get)는 그대로다 — 이미 나간 링크는 만료일까지 열린다.
                    && (
                         (hasUserDoc()
                          && userApprovedAlive(request.auth.uid)
                          && userPaidNow(request.auth.uid))
                         || isAdmin()
                       );
      allow delete: if signedIn()
                    && resource.data.ownerUid == request.auth.uid;   // 만든 본인만 회수
    }
    // ★ 「만드는 사람」 조건(익명 아님 + 승인된 계정)은 **넣지 않았다** (v248, 사장님께 보고).
    //   이유: 앱에는 Firebase 계정 없이 들어오는 길이 있다 —
    //     · index.html 2034행: 로컬 비밀번호(ADMIN_PW, 기본 1234)로 관리자 진입
    //     · index.html 1994행: loginDriver() 기사 진입
    //   이 경우 288행의 signInAnonymously 로 **익명 계정**이 되고, users/{uid} 문서가 없다.
    //   게다가 _test·_demo 는 승인 게이트를 아예 건너뛴다(index.html 2452·2466행).
    //   그래서 hasUserDoc() && approved 를 걸면 _test 공유는 물론,
    //   로컬 비밀번호로 쓰는 실사용자의 공유까지 전부 막힌다.
    //   먼저 앱의 로그인 경로를 정리해야 한다 — 그 뒤에 이 조건을 넣는다.

    // ─────────────────────────────────────────────────────────────────────
    // ☆ 기관 격리는 2026-09-29(코스로드6)에 **켰다.** 위 orgs/{orgId}/data·backups 참고.
    //
    // ☆ 마스터 실계정(admins) 전환도 2026-09-29(코스로드8 ②)에 **했다.**
    //    users list · inquiries · orgs/_master 쓰기를 isAdmin() 으로 닫았다.
    //    단 orgs/_master/data/billing(계좌 안내)만은 승인 대기 중인 가입자도 읽어야 해서 열어 둔다.
    //
    // ☆ orgs/cosroad_global(알리고 공통 설정)도 2026-10-30(v253)에 **isAdmin() 으로 닫았다.**
    //    "업체 관리자도 쓰므로 그대로 둔다"고 적어 두었던 자리인데, 앱이 이 자리를 쓰는
    //    호출이 **0건**임을 확인했다(키는 Vercel 환경변수로 옮겼다). 콘솔에도 문서가 없다.
    //
    //   (cosroad_default 는 2026-09-29 에 닫았다 — 더 쓰지 않기로 확정. 자료는 지우지 않았다.)
    // ─────────────────────────────────────────────────────────────────────
  }
}
