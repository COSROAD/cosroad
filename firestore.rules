// ─────────────────────────────────────────────────────────────────────────────
// 코스로드 Firestore 보안 규칙 (프로젝트 cosroad-9a49c) · 2026-09-28
//
// 적용: Firebase 콘솔 → Firestore Database → 규칙 → 이 파일 내용 전체 붙여넣기 → 게시
// 되돌리기: firestore.rules.backup-20260928-open 내용을 붙여넣기 (전체 개방 상태로 복귀)
//
// 여기에 적히지 않은 경로는 **전부 거부**된다(Firestore 기본값).
//   → 앞으로 새 컬렉션을 쓰는 기능을 만들면 이 파일에 경로를 반드시 추가해야 한다.
//     코드만 만들면 permission-denied 로 조용히 먹통이 된다.
//
// 허용 경로는 index.html 코드에서 실제 호출을 전수 조사해 뽑았다(추측 아님):
//   users/{uid}                     index.html:1842, 1861, 1881, 2033, 2046
//   inquiries/{id}                  index.html:2009, 2022, 2582
//   orgs/_master/data/companies     index.html:2172, 2183
//   orgs/{orgId}/data/{key}         index.html:12148, 12185, 12242
//   orgs/{orgId}/backups/{id}       index.html:12120, 12124, 12134
//   shares/{token}                  index.html:8925, 8998 · s.html:173
// api/ 는 코스로드 Firestore 를 쓰지 않는다(api/rc-notify.js 는 roadcrew-1e9cd 프로젝트).
//
// 앱은 로그인 사용자가 없으면 익명 로그인을 자동으로 한다(index.html:285-287).
// 따라서 `request.auth != null` 만으로는 방어가 되지 않는다 —
// 실계정은 users/{uid} 문서의 존재로 가린다(hasAccount).
// ─────────────────────────────────────────────────────────────────────────────
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── 도우미 ────────────────────────────────────────────────────────────
    function signedIn() {
      return request.auth != null;              // 익명 로그인도 포함된다
    }
    // 실계정만 users 문서를 갖는다 (가입 시 생성 — index.html:1842)
    function hasAccount() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function myOrg() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId;
    }
    function isDemoOrg(orgId) {
      return orgId.matches('.*_demo');
    }

    // ── users/{uid} — 본인 문서만 ─────────────────────────────────────────
    // 가입(create)·로그인 시 읽기(get)·30일무료 마이그레이션 저장(update) 모두 본인 것.
    // list 는 막는다 — 열어두면 가입자 전원의 이메일·요금제·orgId 가 통째로 새어나간다.
    match /users/{uid} {
      allow get:    if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid;
      // orgId 는 만든 뒤 바꿀 수 없다 — 바꿀 수 있으면 남의 기관으로 옮겨탈 수 있다
      allow update: if signedIn() && request.auth.uid == uid
                    && request.resource.data.orgId == resource.data.orgId;
      allow list:   if false;
      allow delete: if false;
    }

    // ── inquiries/{id} — 보내기만 ─────────────────────────────────────────
    // 문의는 로그인 전/데모에서도 보낼 수 있어야 한다(index.html:2582) → create 는 익명 허용.
    // 읽기는 전부 막는다 — 다른 기관의 문의 내용·연락처가 보이면 안 된다.
    match /inquiries/{id} {
      allow create: if signedIn();
      allow get:    if false;
      allow list:   if false;
      allow update: if false;
      allow delete: if false;
    }

    // ── orgs/{orgId}/data/{key} — 기관 자료 (본체) ────────────────────────
    // 회원·거래명세서·수납·세무·근태 등 앱의 모든 자료가 여기 들어간다.
    match /orgs/{orgId}/data/{key} {
      // 둘러보기(데모): 누구나 읽기만. 쓰기는 앱에서도 막혀 있다(isDemoMode).
      allow read: if signedIn() && isDemoOrg(orgId);
      // 실계정: 자기 기관만
      allow read:  if hasAccount() && myOrg() == orgId;
      allow write: if hasAccount() && myOrg() == orgId;
    }

    // ── orgs/{orgId}/backups/{backupId} — 자동 백업 ───────────────────────
    match /orgs/{orgId}/backups/{backupId} {
      allow read:   if hasAccount() && myOrg() == orgId;   // get + list(목록 정리용)
      allow create: if hasAccount() && myOrg() == orgId;
      allow delete: if hasAccount() && myOrg() == orgId;   // 오래된 백업 정리
      allow update: if false;                              // 백업은 덮어쓰지 않는다
    }

    // ── shares/{token} — 카톡 공유 링크 스냅샷 (REPLY_32 확정본) ──────────
    // 방어선은 ① 추측 불가 토큰(128비트) ② list 차단 ③ 만료. "인증됨"은 방어가 아니다.
    match /shares/{token} {
      allow get:    if resource.data.expiresAt > request.time;   // 만료되면 못 읽는다
      allow list:   if false;                                    // 토큰 없이 훑기 차단
      allow update: if false;                                    // 스냅샷 변조 차단
      allow create: if signedIn()
                    && request.resource.data.expiresAt > request.time
                    && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if signedIn()
                    && resource.data.ownerUid == request.auth.uid;   // 만든 본인만 회수
    }

    // ── orgs/_master/data/{key} — 전체 관리자(마스터) 업체 목록 ───────────
    // ⚠ 지금은 막혀 있다. 마스터 패널은 Firebase 로그인 없이 클라이언트 비밀번호만으로
    //    들어가므로(index.html:1963) 규칙으로 "마스터임"을 확인할 방법이 없다.
    //    → 마스터 패널의 업체목록 저장/불러오기와 가입자 목록은 동작하지 않는다.
    //    복구 방법은 REPLY_33 참고(마스터 패널을 Firebase 로그인 + admins 허용목록으로
    //    바꾸는 별도 작업이 필요하다).
    match /orgs/_master/data/{key} {
      allow read, write: if false;
    }

    // ─────────────────────────────────────────────────────────────────────
    // ⚠ 과도기 예외 — 로그인 없이 쓰던 옛 공간(cosroad_default)
    //
    // 지금까지 규칙이 전체 개방이어서, 로그인하지 않은 상태로도 이 공간을 읽고 쓸 수
    // 있었다(index.html:11577 — 로그인·URL 둘 다 없으면 orgId 가 'cosroad_default').
    // 실제로 그렇게 쓰는 이용자가 있는지는 코드로는 알 수 없어 일단 남겨 두었다.
    //
    // ★ 로그인하지 않고 쓰는 이용자가 없다고 확인되면 이 블록(match ~ }) 을 지워라.
    //   지우면 이 공간도 '자기 기관만' 규칙으로 완전히 닫힌다.
    // ─────────────────────────────────────────────────────────────────────
    match /orgs/cosroad_default/data/{key} {
      allow read, write: if signedIn();
    }
    match /orgs/cosroad_default/backups/{backupId} {
      allow read, create, delete: if signedIn();
      allow update: if false;
    }
  }
}
